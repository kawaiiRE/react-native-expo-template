APP_NAME=Expo Starter
APP_SLUG=expo-starter
# Deep-link scheme. Fastify must trust it: CORS_ALLOWED_ORIGINS=expo-starter://
APP_SCHEME=expo-starter
APP_VERSION=1.0.0
ANDROID_VERSION_CODE=1
ANDROID_PACKAGE=dev.example.expostarter
IOS_BUNDLE_IDENTIFIER=dev.example.expostarter
# Optional host of the web frontend that emails verification and reset links
# (for example app.example.com). Enables iOS universal links and Android App
# Links for /verify-email and /reset-password. Leave empty to disable.
APP_LINK_HOST=

# Everything prefixed EXPO_PUBLIC_ is bundled into the app: never put secrets here.
# Backend adapter: "next" (Next.js gateway, bearer tokens) or "fastify"
# (Fastify + Better Auth, session cookie via @better-auth/expo).
EXPO_PUBLIC_BACKEND=next
# Public origin of that backend, without a path or trailing slash. A physical
# device needs your computer's LAN address or an HTTPS tunnel; 127.0.0.1 is the phone.
EXPO_PUBLIC_API_BASE_URL=http://127.0.0.1:3000

EAS_PROJECT_ID=

# Optional: `yarn integration:check` signs in with this verified account.
# Without it the check registers a throwaway account when registration is open.
INTEGRATION_EMAIL=
INTEGRATION_PASSWORD=
# Set to 1 to fail instead of skipping when the backend is unreachable.
INTEGRATION_REQUIRED=
